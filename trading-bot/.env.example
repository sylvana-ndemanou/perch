# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Required only for --live execution (leave blank to run in dry-run/paper mode).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use Binance's Spot Testnet (https://testnet.binance.vision) instead of
# real Binance when running live execution. Strongly recommended before
# ever pointing this at mainnet with real funds.
BINANCE_TESTNET=true

# --- Dashboard (server.py) only, below this line ---

# Places real orders through the dashboard instead of dry-run logging.
LIVE_MODE=false

# Exposes the two-step withdrawal endpoints. Requires LIVE_MODE=true and
# at least one verified entry in whitelist.yaml. Off by default.
ENABLE_WITHDRAWALS=false

# REQUIRED if LIVE_MODE=true: Clerk authentication for the dashboard.
# The server refuses to start in LIVE_MODE without CLERK_JWKS_URL set --
# never run a real-money dashboard with no authentication in front of it.
#
# From your Clerk Dashboard (clerk.com) > Configure > API Keys:
#   CLERK_PUBLISHABLE_KEY: the "Publishable key" (pk_test_... / pk_live_...),
#     sent to the browser so it can load Clerk's sign-in widget. Not a secret.
#   CLERK_JWKS_URL: "https://<your-frontend-api-domain>/.well-known/jwks.json"
#     (your-frontend-api-domain is shown on the same page, e.g.
#     "your-app-name-12ab.clerk.accounts.dev" in development).
#   CLERK_ISSUER: "https://<your-frontend-api-domain>" (same domain, no path).
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
